circuit manual_shor {
  layout {
    orientation: vertical
    scale: 2.1
    column_gap: 0.375
  }
  qubit phase[4]
  qubit value[3]
  parallel {
    h phase[0]
    h phase[1]
    h phase[2]
    h phase[3]
  }
  gate "a^x mod N" on value[0..3] if phase[0], phase[1], phase[2], phase[3]
  gate "inverse QFT" on phase[0..4]
  measure phase[0..4]
}
