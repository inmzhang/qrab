fn forward_layer(a, b, c, d) {
  h a
  x b if a
  phase "pi/4" on c if b
  swap c, d
}

circuit reverse_eight {
  qubit q[8]

  forward_layer(q[0], q[1], q[2], q[3])
  forward_layer(q[4], q[5], q[6], q[7])
  barrier
  reverse {
    h q[0]
    x q[1] if q[0]
    phase "pi/4" on q[2] if q[1]
    swap q[2], q[3]
    h q[4]
    x q[5] if q[4]
    phase "pi/4" on q[6] if q[5]
    swap q[6], q[7]
  }
}
