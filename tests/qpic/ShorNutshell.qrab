circuit shor_nutshell {
  qubit exponent[4]: "|0>" -> "phase"
  qubit value[3]: "|1>" -> "a^x mod N"

  parallel {
    h exponent[0]
    h exponent[1]
    h exponent[2]
    h exponent[3]
  }
  gate "modexp" on value[0..3] if exponent[0], exponent[1], exponent[2], exponent[3] with fill: "#DDEEFF"
  barrier
  gate "inverse QFT" on exponent[0..4] with fill: yellow
  measure exponent[0..4] as "bits"
  brace left "period register" on exponent[0..4]
  brace left "value register" on value[0..3]
}
