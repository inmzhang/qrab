style pale {
  fill: "#F3F4F6"
  stroke: gray
}

circuit gate_compare {
  qubit q[6]

  h q[0]
  x q[1]
  y q[2]
  z q[3]
  s q[4]
  t q[5]
  gate "G" on q[0] with pale
  phase "theta" on q[1] with fill: yellow
  x q[2] if q[0]
  x q[3] if !q[1]
  gate "+" on q[4] if q[2] with shape: circle
  swap q[0], q[5]
  barrier
  measure q[0]
  measure q[1] as "Z"
  measure q[2] as "X" using tag
}
