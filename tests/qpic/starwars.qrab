fn duel(left, right, control) {
  h left
  x right if left
  z left if control
  swap left, right
}

circuit star_wars {
  layout {
    orientation: vertical
    scale: 0.8
    background: "#F8FAFC"
  }

  qubit rebel[4]: "rebel" -> "out"
  ellipsis hyperspace
  qubit empire[4]: "empire" -> "out"

  mark battle
  duel(rebel[0], rebel[1], empire[0])
  duel(rebel[2], rebel[3], empire[1])
  label "..." on hyperspace
  duel(empire[0], empire[1], rebel[0])
  duel(empire[2], empire[3], rebel[1])
  repeat 2 {
    x empire[3] if rebel[3]
    phase "force" on rebel[2] if empire[2]
  }
  group "battle" from battle to here with fill: red, stroke: purple, opacity: 0.12
}
