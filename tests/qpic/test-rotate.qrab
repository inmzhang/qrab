circuit rotated_phases {
  layout {
    orientation: vertical
    scale: 1.1
  }

  qubit a: "a" -> "a"
  qubit b: "b" -> "b"
  qubit c: "c" -> "c"
  qubit k: "z" -> "z"

  phase "k" on a
  phase "1" on b if a
  phase "2" on k if c
  phase "ceil(l/2)" on k if a, b, c
  phase "k-1" on b if a with width: 20
}
