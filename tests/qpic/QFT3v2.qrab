fn controlled_phase(control, target) {
  phase "theta" on target if control
}

circuit qft3_v2 {
  qubit q[3]

  parallel {
    h q[0]
    phase "pi/4" on q[2] if q[1]
  }
  controlled_phase(q[0], q[1])
  controlled_phase(q[0], q[2])
  h q[1]
  controlled_phase(q[1], q[2])
  h q[2]
  permute q[2], q[1], q[0]
}
