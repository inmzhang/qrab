circuit coherent_superdense_coding {
  layout {
    orientation: vertical
    background: "#F7FAFF"
  }

  qubit input[2]: "|xy>" -> "|xy>"
  hidden gap1
  qubit bell[2]: "|00>" -> "|xy>"
  hidden gap2

  mark encoded
  h bell[1]
  x bell[0] if bell[1]
  permute bell[0], gap1, gap2, bell[1]
  z bell[0] if input[1]
  x bell[0] if input[0]
  permute gap2, bell[0]
  x bell[0] if bell[1]
  h bell[1]
  group "quantum channel" from encoded to here on bell[0], bell[1] with fill: green, opacity: 0.2
}
