circuit modular_exponentiation {
  layout {
    scale: 1.3
  }

  qubit high: "|x_n-1>" -> "|x_n-1>"
  ellipsis upper
  qubit middle: "|x_i>" -> "|x_i>"
  ellipsis lower
  qubit low: "|x_0>" -> "|x_0>"
  qubit y: "|y>" -> "|y a^x mod N>"

  gate "M_N(a)" on y if low with width: 25
  label "..." on lower
  gate "M_N(a^(2^i))" on y if middle with width: 35
  label "..." on upper
  gate "M_N(a^(2^(n-1)))" on y if high with width: 40
}
