fn qft_pair(control, target) {
  h control
  phase "2" on target if control
}

fn qft_three(a, b, c) {
  qft_pair(a, b)
  phase "3" on c if a
  qft_pair(b, c)
  h c
}

circuit recursive_qft {
  qubit q[4]
  qft_three(q[0], q[1], q[2])
  phase "4" on q[3] if q[0]
  phase "3" on q[3] if q[1]
  phase "2" on q[3] if q[2]
  h q[3]
}
