fn qft_pair(control, target) {
  h control
  phase "pi/2" on target if control
}

fn qft_three(a, b, c) {
  qft_pair(a, b)
  phase "pi/4" on c if a
  qft_pair(b, c)
  h c
}

circuit recursive_qft {
  qubit q[4]
  qft_three(q[0], q[1], q[2])
  phase "pi/8" on q[3] if q[0]
  phase "pi/4" on q[3] if q[1]
  phase "pi/2" on q[3] if q[2]
  h q[3]
}
