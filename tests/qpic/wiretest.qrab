circuit wire_lifecycle_test {
  qubit a: "a" -> "a"
  ellipsis omitted
  qubit b: "b" -> "b"
  qubit c: "c" -> "c"
  qubit d: "d" -> "d"
  qubit e: "e" -> "e"
  qubit f: "f" -> "f"

  brace left "ab" on a, b
  labels "1"
  end e, f
  end a, omitted, b
  labels "2"
  start e, f
  start a, b
  labels "3"
  set c to classical
  labels "4"
  brace both "register" on c, d, e
}
