circuit checked_declarations {
  qubit q[4]
  qubit a[3]
  qubit b
  qubit c

  x q[0] if q[1], q[2] with stroke: purple
  x a[0]
  x q[3] if q[1], q[2]
  x c if !a[0], !b with stroke: blue
  mark region
  x b if q[2]
  group "auto replacement" from region to here on q[1], q[2], b with fill: red, opacity: 0.2
  measure a[2]
  touch a[0], q[0]
}
