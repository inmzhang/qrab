fn compare_bit(a, b, carry) {
  x carry if a, !b
  x b if a
}

circuit two_bit_compare {
  qubit a0: "a_0" -> "a_0"
  qubit a1: "a_1" -> "a_1"
  qubit b0: "b_0" -> "b_0"
  qubit b1: "b_1" -> "b_1"
  qubit result: "0" -> "a<b"
  hidden ancilla

  set ancilla to quantum as "0"
  compare_bit(a0, b0, result)
  compare_bit(a1, b1, result)
  touch
  set ancilla to hidden as "0"
}
